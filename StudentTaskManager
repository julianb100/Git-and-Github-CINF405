assignments = []
def show_menu():
    """Display the main menu."""
    print("\n===== Student Task Management =====")
    print("1. Add assignment")
    print("2. View assignments")
    print("3. Mark assignment as completed")
    print("4. Exit")

def add_assignment():
    """Add a new assignment to the task list."""
    title = input("Enter assignment title: ").strip()

    if title == "":
        print("Error: Assignment title cannot be empty.")
        return

    description = input("Enter assignment description: ").strip()
    due_date = input("Enter due date (YYYY-MM-DD): ").strip()
    priority = input("Enter priority (High, Medium, Low): ").strip().title()

    if priority not in ["High", "Medium", "Low"]:
        print("Invalid priority. Please use High, Medium, or Low.")
        return

    assignment = {
        "id": len(assignments) + 1,
        "title": title,
        "description": description,
        "due_date": due_date,
        "priority": priority,
        "completed": False
    }

    assignments.append(assignment)
    print("Assignment added successfully!")

def view_assignments():
    """Display all assignments."""
    if not assignments:
        print("\nNo assignments found. Add your first assignment!")
        return

    print("\n===== Your Assignments =====")
    for task in assignments:
        if task["completed"]:
            status = "Completed"
        else:
            status = "Pending"
        print(f"\nID: {task['id']}")
        print(f"Title: {task['title']}")
        print(f"Description: {task['description']}")
        print(f"Due Date: {task['due_date']}")
        print(f"Priority: {task['priority']}")
        print(f"Status: {status}")
def mark_completed():
    """Mark an assignment as completed."""
    view_assignments()

    if not assignments:
        return
    try:
        task_id = int(input("\nEnter the assignment ID: "))
    except ValueError:
        print("Please enter a valid number.")
        return

    for task in assignments:
        if task["id"] == task_id:
            task["completed"] = True
            print("Assignment marked as completed!")
            return

    print("Assignment ID not found.")

def main():
    """Run the application."""
    while True:
        show_menu()
        choice = input("Choose an option (1-4): ").strip()

        if choice == "1":
            add_assignment()
        elif choice == "2":
            view_assignments()
        elif choice == "3":
            mark_completed()
        elif choice == "4":
            print("Thank you for using Student Task Management!")
            break
        else:
            print("Invalid choice. Please select 1, 2, 3, or 4.")

if __name__ == "__main__":
    main()
