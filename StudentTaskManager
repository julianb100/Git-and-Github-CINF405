
import json
import os
from datetime import datetime, date

# Store all assignments
assignments = []

# File used to save assignments
FILE_NAME = "tasks.json"


def load_assignments():
    """Load saved assignments from the JSON file."""
    global assignments

    if os.path.exists(FILE_NAME):
        try:
            with open(FILE_NAME, "r") as file:
                data = json.load(file)

            if isinstance(data, list):
                assignments = data
                print("Previous assignments loaded successfully!")
            else:
                assignments = []
                print("Invalid file format. Starting fresh.")

        except (json.JSONDecodeError, OSError):
            assignments = []
            print("Could not load saved assignments. Starting fresh.")


def save_assignments():
    """Save assignments to the JSON file."""
    try:
        with open(FILE_NAME, "w") as file:
            json.dump(assignments, file, indent=4)
    except OSError:
        print("Error: Could not save assignments.")


def show_menu():
    """Display the main menu."""
    print("\n===== Student Task Management =====")
    print("1. Add assignment")
    print("2. View assignments")
    print("3. Mark assignment as completed")
    print("4. Delete assignment")
    print("5. Search assignments")
    print("6. View assignment statistics")
    print("7. Edit assignment")
    print("8. View overdue assignments")
    print("9. Sort assignments")
    print("10. Save assignments")
    print("11. Exit")


def get_valid_date(prompt):
    """Ask the user for a valid date."""
    due_date = input(prompt).strip()

    try:
        datetime.strptime(due_date, "%Y-%m-%d")
        return due_date
    except ValueError:
        print("Invalid date. Please use YYYY-MM-DD.")
        return None


def get_valid_priority():
    """Ask the user for a valid priority."""
    priority = input(
        "Enter priority (High, Medium, Low): "
    ).strip().title()

    if priority not in ["High", "Medium", "Low"]:
        print("Invalid priority. Please use High, Medium, or Low.")
        return None

    return priority


def add_assignment():
    """Add a new assignment."""
    title = input("Enter assignment title: ").strip()

    if title == "":
        print("Error: Assignment title cannot be empty.")
        return

    description = input("Enter assignment description: ").strip()

    due_date = get_valid_date("Enter due date (YYYY-MM-DD): ")

    if due_date is None:
        return

    priority = get_valid_priority()

    if priority is None:
        return

    # Create a unique assignment ID
    if assignments:
        new_id = max(task["id"] for task in assignments) + 1
    else:
        new_id = 1

    assignment = {
        "id": new_id,
        "title": title,
        "description": description,
        "due_date": due_date,
        "priority": priority,
        "completed": False
    }

    assignments.append(assignment)
    save_assignments()

    print("Assignment added successfully!")


def view_assignments():
    """Display all assignments."""
    if not assignments:
        print("\nNo assignments found.")
        return

    print("\n===== Your Assignments =====")

    for task in assignments:
        status = "Completed" if task["completed"] else "Pending"

        print("\n----------------------------")
        print(f"ID: {task['id']}")
        print(f"Title: {task['title']}")
        print(f"Description: {task['description']}")
        print(f"Due Date: {task['due_date']}")
        print(f"Priority: {task['priority']}")
        print(f"Status: {status}")


def find_assignment(task_id):
    """Find an assignment using its ID."""
    for task in assignments:
        if task["id"] == task_id:
            return task

    return None


def mark_completed():
    """Mark an assignment as completed."""
    view_assignments()

    if not assignments:
        return

    try:
        task_id = int(input("\nEnter assignment ID: "))
    except ValueError:
        print("Please enter a valid number.")
        return

    task = find_assignment(task_id)

    if task is None:
        print("Assignment ID not found.")
        return

    if task["completed"]:
        print("This assignment is already completed.")
    else:
        task["completed"] = True
        save_assignments()
        print("Assignment marked as completed!")


def delete_assignment():
    """Delete an assignment."""
    view_assignments()

    if not assignments:
        return

    try:
        task_id = int(input("\nEnter assignment ID to delete: "))
    except ValueError:
        print("Please enter a valid number.")
        return

    task = find_assignment(task_id)

    if task is None:
        print("Assignment ID not found.")
        return

    assignments.remove(task)
    save_assignments()

    print("Assignment deleted successfully!")


def search_assignments():
    """Search for assignments by title."""
    search_term = input(
        "\nEnter assignment title to search: "
    ).strip().lower()

    if not search_term:
        print("Search cannot be empty.")
        return

    results = [
        task for task in assignments
        if search_term in task["title"].lower()
    ]

    if not results:
        print("No matching assignments found.")
        return

    print("\n===== Search Results =====")

    for task in results:
        status = "Completed" if task["completed"] else "Pending"

        print(f"\nID: {task['id']}")
        print(f"Title: {task['title']}")
        print(f"Due Date: {task['due_date']}")
        print(f"Priority: {task['priority']}")
        print(f"Status: {status}")


def view_statistics():
    """Display assignment statistics."""
    total = len(assignments)

    completed = sum(
        1 for task in assignments if task["completed"]
    )

    pending = total - completed

    overdue = sum(
        1 for task in assignments
        if not task["completed"]
        and datetime.strptime(
            task["due_date"], "%Y-%m-%d"
        ).date() < date.today()
    )

    print("\n===== Assignment Statistics =====")
    print(f"Total Assignments: {total}")
    print(f"Completed Assignments: {completed}")
    print(f"Pending Assignments: {pending}")
    print(f"Overdue Assignments: {overdue}")

    if total > 0:
        percentage = (completed / total) * 100
        print(f"Completion Rate: {percentage:.1f}%")
    else:
        print("Completion Rate: 0%")


def edit_assignment():
    """Edit an existing assignment."""
    view_assignments()

    if not assignments:
        return

    try:
        task_id = int(input("\nEnter assignment ID to edit: "))
    except ValueError:
        print("Please enter a valid number.")
        return

    task = find_assignment(task_id)

    if task is None:
        print("Assignment ID not found.")
        return

    print("\nPress Enter to keep the current information.")

    new_title = input(
        f"New title ({task['title']}): "
    ).strip()

    if new_title:
        task["title"] = new_title

    new_description = input(
        f"New description ({task['description']}): "
    ).strip()

    if new_description:
        task["description"] = new_description

    new_date = input(
        f"New due date ({task['due_date']}): "
    ).strip()

    if new_date:
        try:
            datetime.strptime(new_date, "%Y-%m-%d")
            task["due_date"] = new_date
        except ValueError:
            print("Invalid date. Keeping the original date.")

    new_priority = input(
        f"New priority ({task['priority']}): "
    ).strip().title()

    if new_priority:
        if new_priority in ["High", "Medium", "Low"]:
            task["priority"] = new_priority
        else:
            print("Invalid priority. Keeping the original priority.")

    save_assignments()

    print("Assignment updated successfully!")


def view_overdue():
    """Display assignments that are past their due dates."""
    today = date.today()

    overdue_tasks = [
        task for task in assignments
        if not task["completed"]
        and datetime.strptime(
            task["due_date"], "%Y-%m-%d"
        ).date() < today
    ]

    if not overdue_tasks:
        print("\nYou have no overdue assignments!")
        return

    print("\n===== Overdue Assignments =====")

    for task in overdue_tasks:
        print(f"\nID: {task['id']}")
        print(f"Title: {task['title']}")
        print(f"Due Date: {task['due_date']}")
        print(f"Priority: {task['priority']}")


def sort_assignments():
    """Sort assignments by due date or priority."""
    if not assignments:
        print("\nNo assignments available to sort.")
        return

    print("\n===== Sort Assignments =====")
    print("1. Sort by due date")
    print("2. Sort by priority")

    choice = input("Choose an option: ").strip()

    if choice == "1":
        sorted_tasks = sorted(
            assignments,
            key=lambda task: task["due_date"]
        )

    elif choice == "2":
        priority_order = {
            "High": 1,
            "Medium": 2,
            "Low": 3
        }

        sorted_tasks = sorted(
            assignments,
            key=lambda task: priority_order[task["priority"]]
        )

    else:
        print("Invalid choice.")
        return

    print("\n===== Sorted Assignments =====")

    for task in sorted_tasks:
        status = "Completed" if task["completed"] else "Pending"

        print(
            f"\nID: {task['id']} | "
            f"{task['title']} | "
            f"Due: {task['due_date']} | "
            f"Priority: {task['priority']} | "
            f"Status: {status}"
        )


def main():
    """Run the application."""
    load_assignments()

    while True:
        show_menu()

        choice = input("\nChoose an option (1-11): ").strip()

        if choice == "1":
            add_assignment()

        elif choice == "2":
            view_assignments()

        elif choice == "3":
            mark_completed()

        elif choice == "4":
            delete_assignment()

        elif choice == "5":
            search_assignments()

        elif choice == "6":
            view_statistics()

        elif choice == "7":
            edit_assignment()

        elif choice == "8":
            view_overdue()

        elif choice == "9":
            sort_assignments()

        elif choice == "10":
            save_assignments()
            print("Assignments saved successfully!")

        elif choice == "11":
            save_assignments()
            print("Thank you for using Student Task Management!")
            break

        else:
            print("Invalid choice. Please select a number from 1-11.")


if __name__ == "__main__":
    main()
